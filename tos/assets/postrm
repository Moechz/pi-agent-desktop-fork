#!/bin/bash
# postrm —— 卸载后处理
# 注意：purge 会删除用户数据（会话/记忆/工作区）。
# 指南坑 16：同机上若先用 dpkg 手动装过、后又走应用中心安装，平台会对预存注册走
# purge 路径 → 数据被清空。同一设备请只走一条安装路径；从手动装切应用中心前先备份
# /Volume*/@apps/piagentfortos/data。
set -e

APP_ID=piagentfortos
APP_USER=piagentfortos
MAINT_LOG=/var/log/piagentfortos-maint.log

pkg_log() {
  mkdir -p /var/log 2>/dev/null || true
  echo "$(date '+%F %T') $*" >> "$MAINT_LOG" 2>/dev/null || true
}
pkg_log postrm "$*"

case "$1" in
  purge)
    # 数据（数据卷优先；系统盘默认目录一并清）
    for base in /Volume1/@apps/$APP_ID /Volume2/@apps/$APP_ID /Volume3/@apps/$APP_ID /volume1/@apps/$APP_ID; do
      [ -d "$base" ] && rm -rf "$base" && pkg_log postrm "已删除数据目录 $base"
    done
    rm -rf /var/lib/$APP_ID 2>/dev/null || true

    # 应用目录里由 postinst 生成的文件（piagentfortos.env 等）不在 dpkg 清单内，
    # 不显式删除会留下"非空目录残留"（dpkg 只会打印 warning 而不删目录）。
    rm -rf /usr/local/$APP_ID 2>/dev/null || true

    # 系统层注册（仅删本包自己的产物）
    rm -f /etc/systemd/system/$APP_ID.service 2>/dev/null || true
    rm -rf /etc/systemd/system/$APP_ID.service.d 2>/dev/null || true
    rm -f /etc/nginx/conf.d/$APP_ID.conf 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    if command -v nginx > /dev/null 2>&1; then
      nginx -s reload 2>/dev/null || true
    fi

    # 专用用户（仅 purge 时移除；remove 保留，便于重装沿用同一 uid）
    if id -u "$APP_USER" > /dev/null 2>&1; then
      userdel "$APP_USER" 2>/dev/null || true
      pkg_log postrm "已删除用户 $APP_USER"
    fi
    pkg_log postrm "purge 完成（含用户数据）"
    ;;
  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    # remove 保留数据与用户（重装可无缝续用）；升级不动任何数据
    pkg_log postrm "保留用户数据与系统用户（$1）"
    ;;
esac

exit 0
