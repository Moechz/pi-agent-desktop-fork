APP_ID=@@APP_ID@@
APP_NAME=Pi Agent for TOS
VERSION=@@VERSION@@
ARCH=@@ARCH@@
PLATFORM=@@PLATFORM@@
BUILD_TIME=@@BUILD_TIME@@
SRC_REPO=https://github.com/Moechz/pi-agent-desktop-fork
SRC_COMMIT=@@SRC_COMMIT@@
BUILD_MODE=source
NODE_VERSION=@@NODE_VERSION@@
NODE_SHA256=@@NODE_SHA256@@
RIPGREP_VERSION=@@RIPGREP_VERSION@@
RG_SHA256=@@RG_SHA256@@
FD_VERSION=@@FD_VERSION@@
FD_SHA256=@@FD_SHA256@@
STANDALONE_FILES=@@STANDALONE_FILES@@
STANDALONE_BYTES=@@STANDALONE_BYTES@@
# 数据目录由 postinst 依数据卷探测写入 piagentfortos.env（安全默认 /var/lib/piagentfortos）
LISTEN=127.0.0.1:@@APP_PORT@@@@BASE_PATH@@
BASE_PATH=@@BASE_PATH@@
