# ============================================================
# Pi Agent for TOS —— TOS 7 应用中心 deb 打包配置
# 改完重新运行 ./build.sh 即可（CI 亦读取本文件作为唯一事实源）
# ============================================================

# ---- 应用身份（上架后不可变更，见指南 §一.3：id 牵动十处一致）----
APP_ID=piagentfortos
APP_USER=piagentfortos

# 上游版本（本仓库的定制发布号即上游 0.8.8 + 我们的第 9 次发布）
UPSTREAM_VERSION=0.8.8
CUSTOM_RELEASE=9
# 打包迭代号：同一个应用内容重新打包时递增（dpkg 数值比较，勿零填充）
PKG_RELEASE=18
# 完整版本 = 上游 0.8.8 + 定制第 9 次发布 + 打包迭代 18
# （config.ini / control / .lang 三处必须一致；字面量书写，便于任何非 shell 读取方解析）
# 本版内容：应用代码 = 0.8.8-9（含超长会话 500 修复 + 迭代式 JSON 序列化）
VERSION=0.8.8.9-18

# ---- 目标架构（Debian 名，与 control 的 Architecture 一致）----
TARGET_ARCH=amd64

# ---- 端口：只回环，不对外暴露（TOS nginx 反代 /piagentfortos/ → 本端口）----
# 18141 在目标真机（tnas-57）实测空闲；如需变更，同时改 unit 里的 Environment=PORT
APP_PORT=18141

# ---- 署名分工（指南坑 49 铁律）----
# publisher（config.ini，商店展示的"发布者"）与 Maintainer（dpkg）都是打包者；
# .lang 的 auth 字段填上游项目/作者语义。
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="Moechz"
UPSTREAM_AUTHOR="Pi Agent Desktop"

# ---- config.ini 的 help / official（官方要求：都必须是 github.com 域，脚本 HTTP GET 验链）----
HELP_URL="https://github.com/Moechz/pi-agent-desktop-fork/issues"
OFFICIAL_URL="https://github.com/Moechz/pi-agent-desktop-fork/issues"

# ---- 二进制来源（V6 红线）----
# 本应用是 Node 应用，TOS 基座完全没有 Node（实测 tnas-57：node/npm/bun/deno 全无），
# 因此必须随包携带 Node 运行时与若干原生模块 —— 全部在下方 pin 死版本与 sha256，
# 并把来源写入包内 PROVENANCE.md / BUILD-INFO（指南坑 31/32/43）。
NODE_VERSION=24.21.0
NODE_SHA256_AMD64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
NODE_SHA256_ARM64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2

# 搜索工具（pi 的 grep/find 依赖；否则运行时会尝试联网下载，违反 S8）
RIPGREP_VERSION=15.2.0
FD_VERSION=10.5.0
RG_SHA256_AMD64=33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c
RG_SHA256_ARM64=a740b91c82eaf9914cfedd353572f2791cbe0162c84101ee0951058f4dcbc90d
# fd 上游未提供逐资产 .sha256，以下为从官方 Release（HTTPS）下载后本地计算并固化
FD_SHA256_AMD64=a1259cd129636efbc3fef123525c1b49e88fe5088c012630983c310e52fdfa95
FD_SHA256_ARM64=c0ee43802e3313a317c5af2f4eabd6ba13eeedd595af9775f05e18a13ac4f52c

# ---- 真机（仅本地测试脚本使用，严禁入包/入库）----
TEST_HOST_ALIAS=tnas-57
